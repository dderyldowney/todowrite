# ToDoWrite Environment Configuration Example
# =============================================
# ⚠️  IMPORTANT SECURITY WARNING ⚠️
# This file contains FAKE placeholder values ONLY
# Copy this file to .env.dev for development use
# NEVER commit actual credentials to the repository
# =============================================

# PostgreSQL Database Configuration
TODOWRITE_DATABASE_URL="postgresql://mcp_user:CHANGE_ME_FAKE_PASSWORD@localhost:5433/todowrite"  # pragma: allowlist secret
EPISODIC_MEMORY_DB_URL="postgresql://mcp_user:CHANGE_ME_FAKE_PASSWORD@localhost:5433/mcp_episodic_memory"  # pragma: allowlist secret
MCP_SESSIONS_DB_URL="postgresql://mcp_user:CHANGE_ME_FAKE_PASSWORD@localhost:5433/mcp_sessions"  # pragma: allowlist secret
MCP_FILESYSTEM_DATABASE_URL="postgresql://mcp_user:CHANGE_ME_FAKE_PASSWORD@localhost:5433/mcp_filesystem"  # pragma: allowlist secret
MCP_DATABASE_URL="postgresql://mcp_user:CHANGE_ME_FAKE_PASSWORD@localhost:5433/mcp_main"  # pragma: allowlist secret

# Database Connection Details
MCP_DB_HOST="localhost"
MCP_DB_PORT="5433"
MCP_DB_USER="mcp_user"
MCP_DB_PASSWORD="CHANGE_ME_FAKE_PASSWORD"

# HAL Token Optimization Configuration
HAL_PREPROCESSING_MANDATORY="true"  # pragma: allowlist secret

# Optional: API Keys for External Services (REPLACE WITH YOUR OWN)
# ANTHROPIC_API_KEY="CHANGE_ME_TO_YOUR_REAL_API_KEY"  # pragma: allowlist secret
# CONTEXT7_API_KEY="CHANGE_ME_TO_YOUR_REAL_API_KEY"  # pragma: allowlist secret

# Optional: Session Configuration
# TODOWRITE_SESSION_ID="CHANGE_ME_TO_YOUR_SESSION_ID"  # pragma: allowlist secret

# Development Settings
# LOG_LEVEL="DEBUG"
# PYTHONPATH="lib_package/src:cli_package/src"
